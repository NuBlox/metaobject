{
  "name": "@nublox/metaobject",
  "version": "1.0.0-rc.1",
  "description": "Standalone metadata-driven object model and runtime for TypeScript.",
  "author": "Stephen J T Spittal",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:consumer": "npm run build && node scripts/verify-consumer.mjs",
    "release:check": "npm run check && npm run verify:package && npm run verify:consumer"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
